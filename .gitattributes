# Generated model data of the style auditor's AI-text detector: no text diffs, collapsed in reviews.
crates/akana-core/data/ai_detector/** -diff linguist-generated
crates/akana-core/tests/data/ai_detector_reference.json linguist-generated

# Byte-exact data. The vendored Zemberek dictionaries are checked against pinned SHA-256 sums,
# and the resources compiled into the library are hashed into its analysis and encoder
# fingerprints, so no checkout may convert their line endings.
scripts/lexicon/** -text
crates/akana-core/src/morphology/zemberek_lexicon.txt -text
crates/akana-core/src/morphology/prior.tsv.gz binary
crates/akana-core/src/embeddings/function_lemmas.tsv -text
crates/akana-core/src/readability/kalyoncu_words.txt -text
crates/akana-core/src/pii/person_names.txt -text
crates/akana-core/data/embeddings/** -text
crates/akana-core/tests/data/** -text
data/morphology/** -text

# Licence notices: the copies in the crates and the Python package must stay identical to the
# root file (CI compares them).
**/THIRD_PARTY_NOTICES -text
